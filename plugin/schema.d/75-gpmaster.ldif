dn: cn=schema
changetype: modify
add: attributeTypes
attributeTypes: ( 2.16.840.1.113730.3.8.30.6
  NAME 'ipaGpoChainList'
  DESC 'Ordered list of Group Policy chains'
  EQUALITY distinguishedNameMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 )
-
add: attributeTypes
attributeTypes: ( 2.16.840.1.113730.3.8.30.7
  NAME 'ipaGpoPdcEmulator'
  DESC 'DN of the PDC emulator server'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )
-
add: objectClasses
objectClasses: ( 2.16.840.1.113730.3.8.31.2
  NAME 'ipaGpoMaster'
  DESC 'Group Policy Master configuration object'
  SUP top
  STRUCTURAL
  MUST ( cn $ ipaGpoPdcEmulator )
  MAY ( ipaGpoChainList ) )
